{
  "name": "typewell",
  "version": "1.2.3",
  "private": true,
  "description": "An offline-first font changer for Firefox and Chromium browsers.",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:firefox": "node tests/firefox.mjs",
    "test:chromium": "node tests/chromium.mjs",
    "lint": "web-ext lint --source-dir extension --warnings-as-errors",
    "build": "node scripts/build.mjs",
    "build:chromium": "node scripts/build.mjs --target chromium",
    "build:all": "node scripts/build.mjs --target all",
    "package:amo": "node scripts/package-amo.mjs",
    "start": "web-ext run --source-dir extension",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "selenium-webdriver": "4.49.0",
    "web-ext": "10.6.0"
  }
}
